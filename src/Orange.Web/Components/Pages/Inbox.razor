@page "/inbox"

<PageTitle>Inbox — Orange</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.h5">Inbox</MudText>
        @if (_items.Count > 0)
        {
            <MudBadge Content="@_items.Count" Color="Color.Primary" Overlap="false" />
        }
    </div>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync"
                   Disabled="_loading" />
</div>

@if (_loading)
{
    @for (int i = 0; i < 5; i++)
    {
        <MudSkeleton Height="52px" Class="mb-1" />
    }
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @_error
        <MudButton OnClick="LoadAsync" Variant="Variant.Text" Color="Color.Error">Retry</MudButton>
    </MudAlert>
}
else if (_items.Count == 0)
{
    <MudPaper Class="pa-6 text-center" Elevation="0"
              Style="border:1px dashed var(--mud-palette-divider);border-radius:10px;">
        <MudIcon Icon="@Icons.Material.Filled.MoveToInbox" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">Your inbox is empty.</MudText>
    </MudPaper>
}
else
{
    <MudDataGrid T="Orange.Application.Approvals.GetInbox.InboxItem"
                 Items="_items" Hover="true" Dense="true"
                 RowClick="@(e => OpenDrawer(e.Item.Id))">
        <Columns>
            <TemplateColumn Title="Employee" SortBy="@(x => x.EmployeeName)">
                <CellTemplate>
                    <strong>@context.Item.EmployeeName</strong>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Type" SortBy="@(x => x.Type)">
                <CellTemplate>
                    @LeaveTypeLabel(context.Item.Type)
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Start" SortBy="@(x => x.StartDate)">
                <CellTemplate>
                    @context.Item.StartDate.ToString("d MMM yyyy")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="End" SortBy="@(x => x.EndDate)">
                <CellTemplate>
                    @context.Item.EndDate.ToString("d MMM yyyy")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Days" SortBy="@(x => x.Amount)">
                <CellTemplate>
                    @context.Item.Amount @context.Item.Unit.ToString().ToLower()
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Step">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small">@context.Item.ActiveStepKind</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Submitted" SortBy="@(x => x.SubmittedAt)">
                <CellTemplate>
                    @context.Item.SubmittedAt.ToLocalTime().ToString("d MMM yyyy")
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

<RequestDrawer @ref="_drawer" />
